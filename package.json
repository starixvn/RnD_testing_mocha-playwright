{
    "devDependencies": {
        "@babel/cli": "^7.8.4",
        "@babel/core": "^7.12.10",
        "@babel/node": "^7.12.10",
        "@babel/plugin-transform-regenerator": "^7.12.1",
        "@babel/plugin-transform-runtime": "^7.12.10",
        "@babel/preset-env": "^7.8.4",
        "@babel/register": "^7.12.10",
        "@babel/runtime": "^7.12.5",
        "babel-loader": "^8.0.6",
        "babel-plugin-require-context-hook": "^1.0.0",
        "babel-plugin-transform-runtime": "^6.23.0",
        "babel-polyfill": "^6.26.0",
        "babel-preset-es2015": "^6.24.1",
        "babel-preset-stage-0": "^6.24.1",
        "chai": "4.2.0",
        "mocha": "8.1.3",
        "mochawesome": "^6.2.1",
        "ocrad.js": "0.0.1",
        "pixelmatch": "5.2.1",
        "playwright": "^1.8.0",
        "tesseract.js": "^2.1.4"
    },
    "scripts": {
        "test": "mocha  --timeout 120000 Games/%npm_config_game%/*_Test.js -r @babel/register --file ./Setup.js  --fgrep Full_ --file ./Teardown.js  --reporter mochawesome --reporter-options reportDir=Report ",
        "smoke": "mocha  ./Games/**/*_Test.js  -r @babel/register --file ./Setup.js  --fgrep Smoke_  --file ./Teardown.js  --reporter mochawesome --reporter-options reportDir=Report --timeout 60000",
        "parallel": "mocha --timeout 60000 Games/**/*_Test.js -r @babel/register --require ./configParallel.js Games/**/*_Test.js --parallel -j 2 --reporter mochawesome --require mochawesome/register --reporter-options reportDir=Report,reportFilename=parallelTest "
    },
    "dependencies": {
        "jsonpath": "^1.1.0"
    }
}
